import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_animate/flutter_animate.dart';
import 'package:go_router/go_router.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import '../../core/constants/app_colors.dart';
import '../../core/widgets/app_card.dart';
import '../../core/widgets/app_button.dart';
import '../../core/widgets/progress_ring.dart';
import '../../providers/student_provider.dart';
import '../../providers/shell_tab_provider.dart';
import '../../providers/firebase_providers.dart';

class StudentHomeScreen extends ConsumerStatefulWidget {
  const StudentHomeScreen({super.key, required this.studentId});
  final String studentId;

  @override
  ConsumerState<StudentHomeScreen> createState() => _StudentHomeScreenState();
}

class _StudentHomeScreenState extends ConsumerState<StudentHomeScreen> {
  bool _creating = false;

  Future<void> _ensureStudentDocExists() async {
    if (_creating) return;
    setState(() => _creating = true);

    try {
      final auth = ref.read(firebaseAuthProvider);
      final db = ref.read(firestoreProvider);
      final u = auth.currentUser;

      if (u == null) throw Exception('Not signed in');

      final doc = db.doc('students/${widget.studentId}');
      final snap = await doc.get();
      if (snap.exists) return;

      final now = DateTime.now().millisecondsSinceEpoch;
      final name = u.displayName ?? (u.email?.split('@').first ?? 'Student');
      final email = (u.email ?? '').trim().toLowerCase();

      await doc.set({
        'id': widget.studentId,
        'email': email,
        'name': name,
        'readingLevel': 3.9,
        'weeklyProgress': 0.0,
        'timeSpentMinThisWeek': 0,
        'voiceUsagePct': 0,
        'engagement': 'High',
        'skillTrends': {
          'Comprehension': 'Improving',
          'Vocabulary': 'Improving',
          'Writing': 'Improving',
        },
        'parentUids': <String>[],
        'preferredMode': 'Voice',
        'todayGoal': 'Reading: Understanding paragraphs',
        'updatedAtMs': now,
      }, SetOptions(merge: true));
    } finally {
      if (mounted) setState(() => _creating = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final studentAsync = ref.watch(studentDocProvider(widget.studentId));

    return studentAsync.when(
      loading: () => const Center(child: CircularProgressIndicator()),
      error: (e, _) => Center(
        child: Padding(
          padding: const EdgeInsets.all(20),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              const Icon(Icons.cloud_off, size: 44),
              const SizedBox(height: 10),
              Text(
                'Could not load student profile.\n\n$e',
                textAlign: TextAlign.center,
              ),
              const SizedBox(height: 12),
              ElevatedButton(
                onPressed: () =>
                    ref.invalidate(studentDocProvider(widget.studentId)),
                child: const Text('Retry'),
              ),
            ],
          ),
        ),
      ),
      data: (s) {
        // âœ… Student doc missing: create it (once) and show a clear setup state
        if (s == null) {
          _ensureStudentDocExists();

          return Center(
            child: Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  const CircularProgressIndicator(),
                  const SizedBox(height: 12),
                  Text(
                    _creating
                        ? 'Setting up your student profile...'
                        : 'Student profile not found.\nCreating now...',
                    textAlign: TextAlign.center,
                  ),
                  const SizedBox(height: 12),
                  OutlinedButton(
                    onPressed: _creating ? null : _ensureStudentDocExists,
                    child: const Text('Create now'),
                  ),
                ],
              ),
            ),
          );
        }

        // âœ… Normal UI (your original screen)
        final greeting = _greeting();

        return SingleChildScrollView(
          padding: const EdgeInsets.all(18),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text('Good $greeting ðŸ‘‹',
                  style: const TextStyle(color: AppColors.textMuted)),
              const SizedBox(height: 4),
              Text('Hi, ${s.name}',
                  style: const TextStyle(
                      fontSize: 28, fontWeight: FontWeight.w900)),
              const SizedBox(height: 14),
              GestureDetector(
                onTap: () =>
                    _editGoal(context, ref, widget.studentId, s.todayGoal),
                child: Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(18),
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(20),
                    color: AppColors.indigo,
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(children: [
                        const Text("Today's Goal",
                            style: TextStyle(
                                color: Colors.white70,
                                fontWeight: FontWeight.w600)),
                        const Spacer(),
                        const Icon(Icons.edit, color: Colors.white54, size: 16),
                      ]),
                      const SizedBox(height: 8),
                      Text(
                        s.todayGoal,
                        style: const TextStyle(
                            color: Colors.white,
                            fontSize: 18,
                            fontWeight: FontWeight.w800),
                      ),
                    ],
                  ),
                ),
              ).animate().fadeIn(duration: 350.ms).slideY(begin: 0.05, end: 0),
              const SizedBox(height: 18),
              AppCard(
                child: Row(
                  children: [
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: const [
                          Text('Weekly Progress',
                              style: TextStyle(
                                  color: AppColors.textMuted,
                                  fontWeight: FontWeight.w700)),
                          SizedBox(height: 4),
                          Text('Keep going â€” small steps count.',
                              style: TextStyle(color: AppColors.textMuted)),
                        ],
                      ),
                    ),
                    ProgressRing(progress: s.weeklyProgress),
                  ],
                ),
              ),
              const SizedBox(height: 12),
              AppButton(
                label: 'Start Lesson',
                icon: Icons.play_arrow_rounded,
                onPressed: () => ref.read(shellTabProvider.notifier).state = 2,
              ),
              const SizedBox(height: 10),
              AppButton(
                label: 'Ask AI Tutor',
                icon: Icons.smart_toy_rounded,
                onPressed: () => ref.read(shellTabProvider.notifier).state = 1,
              ),
              const SizedBox(height: 18),
              const SectionTitle('Quick Stats'),
              const SizedBox(height: 10),
              Row(
                children: [
                  Expanded(
                      child: _statCard(
                          icon: Icons.timer_outlined,
                          label: 'Time This Week',
                          value: '${s.timeSpentMinThisWeek} min')),
                  const SizedBox(width: 10),
                  Expanded(
                      child: _statCard(
                          icon: Icons.record_voice_over_outlined,
                          label: 'Voice Usage',
                          value: '${s.voiceUsagePct}%')),
                ],
              ),
              const SizedBox(height: 10),
              Row(
                children: [
                  Expanded(
                      child: _statCard(
                          icon: Icons.trending_up_outlined,
                          label: 'Engagement',
                          value: s.engagement)),
                  const SizedBox(width: 10),
                  Expanded(
                      child: _statCard(
                          icon: Icons.menu_book_outlined,
                          label: 'Reading Level',
                          value: s.readingLevel.toStringAsFixed(1))),
                ],
              ),
              const SizedBox(height: 18),
              AppCard(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text('Skill Trends',
                        style: TextStyle(fontWeight: FontWeight.w800)),
                    const SizedBox(height: 10),
                    for (final entry in s.skillTrends.entries)
                      Padding(
                        padding: const EdgeInsets.only(bottom: 8),
                        child: Row(
                          children: [
                            Expanded(
                                child: Text(entry.key,
                                    style: const TextStyle(
                                        color: AppColors.textMuted))),
                            Text(entry.value,
                                style: const TextStyle(
                                    fontWeight: FontWeight.w800)),
                          ],
                        ),
                      ),
                  ],
                ),
              ),
              const SizedBox(height: 18),
              AppButton(
                label: 'Open Practice',
                icon: Icons.menu_book_rounded,
                onPressed: () => ref.read(shellTabProvider.notifier).state = 2,
              ),
            ],
          ),
        );
      },
    );
  }

  String _greeting() {
    final h = DateTime.now().hour;
    if (h < 12) return 'morning';
    if (h < 17) return 'afternoon';
    return 'evening';
  }

  Future<void> _editGoal(BuildContext context, WidgetRef ref, String studentId,
      String current) async {
    final ctrl = TextEditingController(text: current);
    final result = await showDialog<String>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('Edit today\'s goal'),
        content: TextField(controller: ctrl, maxLines: 2),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(context),
              child: const Text('Cancel')),
          ElevatedButton(
              onPressed: () => Navigator.pop(context, ctrl.text.trim()),
              child: const Text('Save')),
        ],
      ),
    );

    if (result == null || result.isEmpty) return;

    final db = ref.read(firestoreProvider);
    await db.doc('students/$studentId').set({
      'todayGoal': result,
      'updatedAtMs': DateTime.now().millisecondsSinceEpoch
    }, SetOptions(merge: true));
  }
}

class SectionTitle extends StatelessWidget {
  const SectionTitle(this.text, {super.key});
  final String text;

  @override
  Widget build(BuildContext context) {
    return Text(text,
        style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w900));
  }
}

Widget _statCard(
    {required IconData icon, required String label, required String value}) {
  return AppCard(
    child: Row(
      children: [
        Icon(icon, color: AppColors.textMuted),
        const SizedBox(width: 10),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(label,
                  style: const TextStyle(
                      color: AppColors.textMuted, fontWeight: FontWeight.w700)),
              const SizedBox(height: 4),
              Text(value, style: const TextStyle(fontWeight: FontWeight.w900)),
            ],
          ),
        ),
      ],
    ),
  );
}
